APP_NAME=Governance Management Portal
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://governance:change-me@postgres:5432/governance_portal
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-strong-secret-from-your-secret-manager
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
FRONTEND_ORIGIN=https://governance.example.com
FILE_STORAGE_PATH=storage/documents
STORAGE_BACKEND=s3
S3_BUCKET=governance-documents
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=managed-outside-repo
AWS_SECRET_ACCESS_KEY=managed-outside-repo
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=managed-outside-repo
SMTP_PASSWORD=managed-outside-repo
NOTIFICATION_FROM_EMAIL=governance@example.com
SSO_ENABLED=true
DEMO_SEED_ENABLED=false
